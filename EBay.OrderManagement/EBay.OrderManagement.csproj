<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472</TargetFrameworks>
    <RootNamespace>EBay.OrderManagement</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1570;CS1591</NoWarn>
    <Version>0.3.0</Version>
    <Authors>eBay</Authors>
    <Description>Order Management SDK for eBay APIs - combines REST and GraphQL clients</Description>
    <PackageProjectUrl>https://github.com/eBay/order-management-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eBay/order-management-dotnet-sdk</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- REST: Kiota runtime -->
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />
    <!-- StrawberryShake 15+ dropped netstandard2.0; 14.3.x is the last line usable from net472 -->
    <PackageReference Include="StrawberryShake" Version="14.3.3" />
    <PackageReference Include="StrawberryShake.Transport.Http" Version="14.3.3" />
    <PackageReference Include="StrawberryShake.Transport.WebSockets" Version="14.3.3" />

    <!-- GraphQL: StrawberryShake runtime + Roslyn source generator -->
    <PackageReference Include="StrawberryShake.Server" Version="14.3.3" />
  </ItemGroup>

</Project>
